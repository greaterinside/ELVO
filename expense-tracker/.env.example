# Copy to .env.local for local development. On Vercel, add these under
# Project Settings > Environment Variables.

# Password for the Admin sign-in. Demo default if unset: demo-admin
ADMIN_PASSWORD=demo-admin

# Any long random string. Signs the login cookie.
SESSION_SECRET=change-me-to-a-long-random-string

# Turns on automatic receipt reading. Without it, people type the amount.
ANTHROPIC_API_KEY=

# Database: Supabase. Vercel's Supabase integration sets POSTGRES_URL for you.
# For a Supabase project you connect by hand, copy the "Transaction pooler"
# connection string from Supabase (Connect > Connection string) into DATABASE_URL.
# The tables are created automatically in a schema named "receipts".
POSTGRES_URL=
DATABASE_URL=

# Optional: the address of your Tally MCP server. When set, the admin connects
# Tally with a single button in Settings and types nothing.
TALLY_MCP_URL=

# Optional: Tally's HTTP gateway, e.g. http://your-tally-host:9000
# When set, "Push to Tally" posts the vouchers there.
TALLY_URL=
TALLY_COMPANY=
